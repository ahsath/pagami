---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { TOC } from "astro-toc";
import DocsHeader from "../../components/layout/DocsHeader.astro";
import ToC from "../../components/layout/ToC.vue";

export async function getStaticPaths() {
  const docs = await getCollection("docs");

  return docs.map((entry) => {
    const [locale, ...slugParts] = entry.id.split("/");
    return {
      params: { locale, slug: slugParts.join("/") },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const toc = headings.map(({ depth, slug, text }) => ({
  depth,
  title: text,
  url: "#" + slug,
}));
---

<DocsLayout title={entry.data.title} entry={entry}>
  <DocsHeader slot="header" entry={entry} />

  <article class="pane">
    <Content />
  </article>

  <ToC
    client:load
    slot="toc"
    label={Astro.locals.t("toc.onThisPage")}
    closeLabel={Astro.locals.t("common.closeMenu")}
  >
    <TOC toc={toc} />
  </ToC>
</DocsLayout>
