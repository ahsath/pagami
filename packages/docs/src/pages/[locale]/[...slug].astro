---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { TOC } from "astro-toc";
import Header from "../../components/layout/Header.vue";
import ToC from "../../components/layout/ToC.vue";
import TocToggle from "../../components/layout/TocToggle.vue";

export async function getStaticPaths() {
  const docs = await getCollection("docs");

  return docs.map((entry) => {
    const [locale, ...slugParts] = entry.id.split("/");

    return {
      params: {
        locale,
        slug: slugParts.join("/"),
      },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Get all documents to find translations
const allDocs = await getCollection("docs");
const translations = allDocs.filter(
  (d) => d.data.key === entry.data.key && d.data.key !== undefined,
);

const translationMap = Object.fromEntries(
  translations.map((t) => {
    const [loc, ...slugParts] = t.id.split("/");
    return [loc, `/${loc}/${slugParts.join("/").replace(/\.mdx?$/, "")}`];
  }),
);

const toc = headings.map(({ depth, slug, text }) => ({
  depth,
  title: text,
  url: "#" + slug,
}));
---

<DocsLayout title={entry.data.title} translations={translationMap}>
  <Header
    client:load
    slot="header"
    locale={Astro.currentLocale}
    translations={translationMap}
  >
    <TocToggle client:load slot="trailing" />
  </Header>

  <article class="pane">
    <Content />
  </article>

  <ToC client:load slot="toc" label={Astro.locals.t("toc.onThisPage")}>
    <TOC toc={toc} />
  </ToC>
</DocsLayout>
