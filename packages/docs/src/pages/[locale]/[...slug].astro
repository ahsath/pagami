---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { TOC } from "astro-toc";
import Header from "../../components/layout/Header.vue";
import ToC from "../../components/layout/ToC.vue";
import TocToggle from "../../components/layout/TocToggle.vue";

export async function getStaticPaths() {
  const docs = await getCollection("docs");

  // --- Real page paths ---
  const pagePaths = docs.map((entry) => {
    const [locale, ...slugParts] = entry.id.split("/");

    const translations = docs.filter(
      (d) => d.data.key === entry.data.key && d.data.key !== undefined,
    );

    const translationMap = Object.fromEntries(
      translations.map((t) => {
        const [loc, ...tSlugParts] = t.id.split("/");
        return [loc, `/${loc}/${tSlugParts.join("/")}`];
      }),
    );

    return {
      params: { locale, slug: slugParts.join("/") },
      props: { entry, translationMap, redirectTo: null as string | null },
    };
  });

  // --- Section-level redirect paths ---
  // Collect all unique parent folder slugs (e.g. "componentes", "components")
  const realSlugs = new Set(
    pagePaths.map((p) => `${p.params.locale}/${p.params.slug}`),
  );

  const sectionRedirects: typeof pagePaths = [];
  const seenSections = new Set<string>();

  for (const doc of docs) {
    const [locale, ...parts] = doc.id.split("/");
    // Walk each ancestor folder (everything except the last filename segment)
    for (let i = 1; i < parts.length; i++) {
      const sectionSlug = parts.slice(0, i).join("/");
      const key = `${locale}/${sectionSlug}`;
      if (seenSections.has(key) || realSlugs.has(key)) continue;
      seenSections.add(key);

      // Find first doc under this section to redirect to
      const firstDoc = docs.find((d) =>
        d.id.startsWith(`${locale}/${sectionSlug}/`),
      );
      if (!firstDoc) continue;
      const [, ...targetParts] = firstDoc.id.split("/");
      sectionRedirects.push({
        params: { locale, slug: sectionSlug },
        props: {
          entry: null,
          translationMap: {},
          redirectTo: `/${locale}/${targetParts.join("/")}`,
        },
      });
    }
  }

  return [...pagePaths, ...sectionRedirects];
}

const { entry, translationMap, redirectTo } = Astro.props;

// If it's a section redirect, we don't need to render content
const rendered = entry ? await render(entry) : null;
const toc = rendered
  ? rendered.headings.map(({ depth, slug, text }) => ({
      depth,
      title: text,
      url: "#" + slug,
    }))
  : [];

const Content = rendered?.Content;
---

{
  redirectTo ? (
    <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
  ) : (
    <DocsLayout title={entry?.data.title}>
      <Header
        client:load
        slot="header"
        locale={Astro.currentLocale}
        translations={translationMap}
        openMenuLabel={Astro.locals.t("common.openMenu")}
        selectorLabel={Astro.locals.t("common.languageSelector")}
      >
        <TocToggle
          client:load
          slot="trailing"
          label={Astro.locals.t("toc.toggle")}
        />
      </Header>

      <article class="pane">
        {Content && <Content />}
      </article>

      <ToC
        client:load
        slot="toc"
        label={Astro.locals.t("toc.onThisPage")}
        closeLabel={Astro.locals.t("common.closeMenu")}
      >
        <TOC toc={toc} />
      </ToC>
    </DocsLayout>
  )
}
