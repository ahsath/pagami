---
import "../assets/styles/global.css";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { SidebarMenuGroup } from "../types/nav";
import Sidebar from "../components/layout/Sidebar.vue";

interface Props {
  title?: string;
  translations?: Record<string, string>;
}

const { title, translations } = Astro.props;

const locale = Astro.currentLocale ?? "es";

const docs = await getCollection("docs", ({ id }) => id.startsWith(locale));

const sidebarMenu = new Map<string, SidebarMenuGroup>();

for (const doc of docs) {
  const idParts = doc.id.split("/");
  const label = idParts[1].charAt(0).toUpperCase() + idParts[1].slice(1);
  const [, ...pathRest] = idParts;

  if (!sidebarMenu.has(label)) {
    sidebarMenu.set(label, { label, items: [] });
  }

  sidebarMenu.get(label)!.items.push({
    label: doc.data.title,
    slug: getRelativeLocaleUrl(locale, pathRest.join("/")),
  });
}
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="mx-auto max-w-xl">
    <a href="#main-content" class="sr-only focus:not-sr-only">
      {Astro.locals.t("common.skipToContent")}
    </a>
    <slot name="header" />
    <div class="flex">
      <Sidebar
        client:load
        menu={[...sidebarMenu.values()]}
        currentPath={Astro.url.pathname}
      />
      <main id="main-content" class="grow">
        <slot />
      </main>
      <slot name="toc" />
    </div>
  </body>
</html>
