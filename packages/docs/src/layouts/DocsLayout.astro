---
import "../assets/styles/global.css";
import { getCollection, type CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { SEO } from "astro-seo";
import { buildTranslationMap } from "../utils/translations";
import type { SidebarMenuGroup } from "../types/nav";
import Sidebar from "../components/layout/Sidebar.vue";

interface Props {
  title?: string;
  description?: string;
  entry?: CollectionEntry<"docs">;
}

const { title, description, entry } = Astro.props;
const { slug } = Astro.params;
const locale = Astro.currentLocale ?? "es";

const allDocs = await getCollection("docs");

// Build translation map for SEO
let translationMap: Record<string, string> = {};
if (entry) {
  const pathExtractor = slug
    ? (id: string) => "/" + id
    : (id: string) => {
        const [loc, category] = id.split("/");
        return `/${loc}/${category}`;
      };

  translationMap = buildTranslationMap(allDocs, entry, pathExtractor);
}

const languageAlternates = Object.entries(translationMap).map(
  ([loc, path]) => ({
    href: new URL(path, Astro.site).toString(),
    hrefLang: loc,
  }),
);

// Add x-default fallback
if (translationMap["es"]) {
  languageAlternates.push({
    href: new URL(translationMap["es"], Astro.site).toString(),
    hrefLang: "x-default",
  });
}

const sidebarMenu = new Map<string, SidebarMenuGroup>();

for (const doc of allDocs) {
  if (!doc.id.startsWith(locale)) continue;

  const idParts = doc.id.split("/");
  const label = idParts[1].charAt(0).toUpperCase() + idParts[1].slice(1);
  const [, ...pathRest] = idParts;

  if (!sidebarMenu.has(label)) {
    sidebarMenu.set(label, { label, items: [] });
  }

  sidebarMenu.get(label)!.items.push({
    label: doc.data.title,
    slug: getRelativeLocaleUrl(locale, pathRest.join("/")),
    pattern: doc.data.pattern,
  });
}
---

<!doctype html>
<html lang={locale} class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title + " - Vuei"}
      description={description}
      canonical={new URL(Astro.url.pathname, Astro.site).toString()}
      languageAlternates={languageAlternates}
    />
  </head>
  <body class="mx-auto max-w-xl">
    <a href="#main" class="skip-link">
      {Astro.locals.t("common.skipToContent")}
    </a>
    <slot name="header" />
    <div class="flex">
      <Sidebar
        client:load
        menu={[...sidebarMenu.values()]}
        currentPath={Astro.url.pathname}
        closeLabel={Astro.locals.t("common.closeMenu")}
      />
      <main id="main" tabindex="-1" class="grow min-w-0">
        <slot />
      </main>
      <slot name="toc" />
    </div>
  </body>
</html>
