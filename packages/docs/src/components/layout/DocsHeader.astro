---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Header from "./Header.vue";
import TocToggle from "./TocToggle.vue";
import { buildTranslationMap } from "../../utils/translations";

interface Props {
  entry?: CollectionEntry<"docs">;
  pathExtractor?: (id: string) => string;
  hideToc?: boolean;
}

const { entry, pathExtractor = (id) => "/" + id, hideToc = false } = Astro.props;

let translationMap: Record<string, string> = {};
if (entry) {
  translationMap = buildTranslationMap(
    await getCollection("docs"),
    entry,
    pathExtractor,
  );
}
---

{
  /* 
    We render two different Header versions instead of a conditional slot 
    to prevent Astro from generating an empty <astro-slot> container.
    This avoids Vue hydration mismatch errors when the slot is empty.
  */
  hideToc ? (
    <Header
      client:load
      locale={Astro.currentLocale}
      translations={translationMap}
      openMenuLabel={Astro.locals.t("common.openMenu")}
      selectorLabel={Astro.locals.t("common.languageSelector")}
    />
  ) : (
    <Header
      client:load
      locale={Astro.currentLocale}
      translations={translationMap}
      openMenuLabel={Astro.locals.t("common.openMenu")}
      selectorLabel={Astro.locals.t("common.languageSelector")}
    >
      <TocToggle
        client:load
        slot="trailing"
        label={Astro.locals.t("toc.toggle")}
      />
    </Header>
  )
}
