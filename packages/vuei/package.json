{
  "name": "@pagami/vuei",
  "version": "0.1.54",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahsath/pagami.git",
    "directory": "packages/vuei"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/vuei.es-bundler.js",
  "module": "./dist/vuei.es-bundler.js",
  "types": "./dist/types/vuei.d.ts",
