    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "@vueuse/integrations": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "focus-trap": "^7.6.6",
    "reka-ui": "^2.6.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
